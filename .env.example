# =============================================================================
# hoizr-client — Next.js customer-facing app (default port: 3002)
# =============================================================================
# Copy to `.env` (or `.env.local`) at the project root and fill in.
# Restart `next dev` after edits.

# ---- Backend GraphQL APIs ---------------------------------------------------
# IMPORTANT — NEXT_PUBLIC_* values are baked into the client bundle at
# `next build` time. The deployment server MUST have these set BEFORE
# running `next build`, otherwise the browser will try to hit the
# fallback (localhost:4001) and login + every authenticated mutation
# will fail with "Failed to fetch".
#
# Local dev (laptop):
#   NEXT_PUBLIC_CUSTOMER_API_URL=http://localhost:4001/graphql
#   NEXT_PUBLIC_MAIN_API_URL=http://localhost:4000/graphql
#
# dev.hoizr.com (DigitalOcean droplet, dev branch):
#   NEXT_PUBLIC_CUSTOMER_API_URL=https://dev-orderapi.hoizr.com/graphql
#   NEXT_PUBLIC_MAIN_API_URL=https://dev-api.hoizr.com/graphql
#
# Production (www.hoizr.com):
#   NEXT_PUBLIC_CUSTOMER_API_URL=https://customer-api.hoizr.com/graphql
#   NEXT_PUBLIC_MAIN_API_URL=https://api.hoizr.com/graphql
NEXT_PUBLIC_CUSTOMER_API_URL=http://localhost:4001/graphql
NEXT_PUBLIC_MAIN_API_URL=http://localhost:4000/graphql

# ---- App config -------------------------------------------------------------
# Dev: NEXT_PUBLIC_HOIZR_ENV=dev | Production: NEXT_PUBLIC_HOIZR_ENV=prod
NEXT_PUBLIC_HOIZR_ENV=dev
# Canonical public URL — used in sitemap.ts, JSON-LD, OG tags.
# Local: http://localhost:3002
# dev.hoizr.com: https://dev.hoizr.com
# Production: https://www.hoizr.com (or https://hoizr.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# ---- Google OAuth (Google login button on /login) ---------------------------
# SAME value as customer-server's GOOGLE_OAUTH_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# ---- Tracking server endpoint -----------------------------------------------
# Falls back to http://localhost:4100 in dev if unset. Production points
# at tracking.hoizr.com.
NEXT_PUBLIC_TRACKING_SERVER_URL=http://localhost:4100

# ---- Cloudinary (browser image rendering + signed upload preset) ------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_IMAGE_PRESET=hoizr-uploads

# ---- Firebase Cloud Messaging (web push notifications) ----------------------
# Optional — WebPushPrompt component no-ops silently when unset. Get
# values from Firebase Console → Project Settings → General → Your apps.
# VAPID_KEY is under Cloud Messaging tab → Web configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ---- PostHog product analytics ----------------------------------------------
# Project token is write-only — safe to commit / expose in browser bundles.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Swiggy Dineout (dev-gated) ---------------------------------------------
# Gates the /dineout page (404s when not "true"). Flip on only after Swiggy
# production access is granted. The connect button navigates to
# `${customerApiOrigin}/auth/swiggy/start` on customer-server, so no extra
# origin var is needed — it reuses NEXT_PUBLIC_CUSTOMER_API_URL above.
NEXT_PUBLIC_SWIGGY_DINEOUT_ENABLED=false

# ---- Instagram / Meta feature gate -------------------------------------------
# Gates ALL customer-facing Instagram surfaces: the profile "Connect Instagram"
# card and the event/order "who's going" attendees card. Unset/false = hidden
# (default while Meta app verification is pending). Flip to true once verified.
# Server-side truth for data collection stays META_VERIFIED on customer-server;
# this is the UI mirror.
NEXT_PUBLIC_INSTA_ENABLED=false
