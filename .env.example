# =============================================================================
# hoizr-client — Next.js customer-facing app (default port: 3002)
# =============================================================================
# Copy to `.env.local` and fill in. Restart `next dev` after edits.

# ---- Backend GraphQL APIs ---------------------------------------------------
NEXT_PUBLIC_CUSTOMER_API_URL=http://localhost:4001/graphql
NEXT_PUBLIC_MAIN_API_URL=http://localhost:4000/graphql

# ---- App config -------------------------------------------------------------
NEXT_PUBLIC_HOIZR_ENV=dev
# Canonical public URL — used in sitemap.ts, JSON-LD, OG tags.
# Falls back to https://hoizr.com if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# ---- Google OAuth (Google login button on /login) ---------------------------
# SAME value as customer-server's GOOGLE_OAUTH_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# ---- Razorpay (checkout open from browser) ----------------------------------
# Just the KEY ID — never put the SECRET in any frontend env file.
# Same value as the backends' RAZORPAY_KEY_ID.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---- Tracking server endpoint -----------------------------------------------
# Falls back to http://localhost:4100 in dev if unset. Production points
# at tracking.hoizr.com. (tracking-server is excluded from the minimum
# dev environment — leave the localhost default.)
NEXT_PUBLIC_TRACKING_SERVER_URL=http://localhost:4100

# ---- Cloudinary (browser image rendering + signed upload presets) -----------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_IMAGE_PRESET=hoizr-uploads

# ---- Firebase Cloud Messaging (web push notifications) ----------------------
# Optional — WebPushPrompt component no-ops silently when unset.
# Get values from Firebase Console → Project Settings → General → Your apps.
# VAPID_KEY is under Cloud Messaging tab → Web configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ---- PostHog product analytics ----------------------------------------------
# Project token is write-only — safe to commit / expose in browser bundles.
# Defaults: 2026-01-30 (set in src/components/analytics/PostHogProvider.tsx).
NEXT_PUBLIC_POSTHOG_KEY=phc_kf39rdz4pz3XE9RHLA2FMUkwmAJZT2edzzJTQyXzcJQ
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=215070
